DATABASE_URL="postgresql://ducklog:ducklog@db:5432/ducklog?schema=public"

# docker-compose가 호스트에 노출하는 포트 (변경 시 docker-compose.yml 수정 불필요)
APP_PORT=3000
DB_PORT=5432

# 관리자 계정 (컨테이너 시작/로그인 시 이 값으로 자동 생성·갱신됨)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# 세션 토큰 서명에 쓰는 비밀키 — 반드시 직접 랜덤 값으로 교체하세요.
# 생성 예시: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
